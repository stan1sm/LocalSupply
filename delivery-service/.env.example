PORT=3002

# Same PostgreSQL DB as LocalSupply backend
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL of LocalSupply backend webhook endpoint
LOCALSUPPLY_WEBHOOK_URL=https://your-backend.vercel.app/api/wolt/webhook

# Must match WOLT_WEBHOOK_SECRET in LocalSupply backend
WOLT_WEBHOOK_SECRET=your-shared-secret

# Public base URL of this delivery service (used in tracking URLs)
DELIVERY_BASE_URL=https://your-delivery-service.vercel.app

# Status simulation delays in milliseconds (defaults: 5 min / 15 min)
DELIVERY_PICKUP_DELAY_MS=300000
DELIVERY_DELIVER_DELAY_MS=900000

# Vercel cron secret (set in Vercel dashboard, auto-injected into cron requests)
CRON_SECRET=your-vercel-cron-secret

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://localsupply.no,https://localsupply-api.vercel.app

# Main app URL — used for "Back to orders" link on the tracking page
LOCALSUPPLY_APP_URL=https://localsupply.no
