{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "api/cron/advance-deliveries.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/cron/advance-deliveries", "dest": "/api/cron/advance-deliveries" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
