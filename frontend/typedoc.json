{
  "$schema": "https://typedoc.org/schema.json",
  "name": "LocalSupply — Frontend",
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**"
  ],
  "out": "docs",
  "tsconfig": "./tsconfig.typedoc.json",
  "readme": "none",
  "excludePrivate": true,
  "cleanOutputDir": true,
  "groupOrder": ["Functions", "Type Aliases", "Variables", "*"],
  "sort": ["source-order"]
}
